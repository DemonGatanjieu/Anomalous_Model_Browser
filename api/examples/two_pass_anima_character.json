{
 "name": "Example: two passes on Anima, only the character redrawn",
 "title": {
  "zh": "两段放大",
  "en": "Two passes"
 },
 "version": {
  "zh": "Anima · 背景虚化，只重画人物",
  "en": "Anima · blurred background, only the character redrawn"
 },
 "family": "anima",
 "recommended": false,
 "packs": {
  "AnimaLLLiteApply_sdscripts": "ComfyUI-Anima-LLLite",
  "InspyrenetRembg": "comfyui-inspyrenet-rembg",
  "InpaintCropImproved": "ComfyUI-Inpaint-CropAndStitch",
