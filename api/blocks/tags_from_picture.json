{
  "job": "process",
  "want": "tags",
  "rank": 3,
  "short": "its tags",
  "title": {
    "zh": "读图出标签",
    "en": "Tags from a picture"
  },
  "about": {
    "zh": "读出一张图的标签，交给 AI 当文字用。",
    "en": "Reads a picture's tags and hands them to the AI as words."
  },
  "source": {
    "zh": "参考工作流的「图像反推」组",
    "en": "The reference workflow's interrogation group"
  },
  "packs": {
    "WD14Tagger|pysssss": "ComfyUI-WD14-Tagger"
  },
  "takes": "picture",
  "nodes": {
    "picture": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "$image"
      }
    },
    "tags": {
      "class_type": "WD14Tagger|pysssss",
      "inputs": {
        "image": [
          "picture",
          0
        ],
        "model": "wd-eva02-large-tagger-v3",
        "threshold": 0.35,
        "character_threshold": 0.85,
        "replace_underscore": false,
        "trailing_comma": false,
        "exclude_tags": ""
      }
    }
  },
  "after": "run_workflow (what the canvas makes is made too): run_status's answer has texts, the picture's tags. Write the prompt from them with set_prompt, keeping the quality words the prompt has, then remove_nodes these two so later runs skip them.",
  "notes": "The source's model and thresholds (wd-eva02-large-tagger-v3, 0.35, 0.85).",
  "models": [],
  "tested": {
    "gpu": "RTX 4050 Laptop",
    "vram_gb": 6,
    "date": "2026-10-27",
    "runs": [
      {
        "model": "—",
        "size": "1280×832",
        "seconds": 166
      }
    ]
  }
}
