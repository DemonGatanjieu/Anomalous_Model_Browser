{
  "job": "repaint",
  "rank": 3,
  "short": "built-in nodes",
  "title": {
    "zh": "局部重绘·官方节点",
    "en": "Repaint: built-in nodes"
  },
  "about": {
    "zh": "只用 ComfyUI 自带的节点重画圈出的地方，没装别的包时用。",
    "en": "ComfyUI's own nodes only: for when the packs above are missing."
  },
  "source": {
    "zh": "ComfyUI 官方的局部重绘做法",
    "en": "ComfyUI's own way to inpaint"
  },
  "packs": {},
  "takes": "inpaint",
  "nodes": {
    "picture": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "$image"
      }
    },
    "soft": {
      "class_type": "DifferentialDiffusion",
      "inputs": {
        "model": [
          "$sampler.model",
          "*"
        ]
      },
      "wire_to": "$sampler"
    },
    "encode": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "picture",
          0
        ],
        "vae": [
          "$decode.vae",
          "*"
        ]
      }
    },
    "area": {
      "class_type": "SetLatentNoiseMask",
      "inputs": {
        "samples": [
          "encode",
          0
        ],
        "mask": [
          "picture",
          1
        ]
      },
      "wire_to": "$sampler"
    }
  },
  "roles": {
    "sampler": {
      "denoise": 0.7
    }
  },
  "after": "The sampler repaints only the area, at denoise 0.7 so it keeps the picture's look (higher changes more). Then run_workflow.",
  "models": [],
  "tested": {}
}
