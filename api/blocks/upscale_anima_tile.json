{
  "job": "upscale",
  "want": "anima tile",
  "rank": 5,
  "short": "Anima Tile 1.22×",
  "title": {"zh": "Anima Tile 放大细化", "en": "Anima Tile detail upscale"},
  "about": {"zh": "用底图引导 Anima 高降噪放大，另存细化图。", "en": "Use the base picture to guide an Anima high-denoise upscale and save it separately."},
  "source": {"zh": "参考 Aaalice 工作流的潜空间放大；本机未使用其 Tile 预处理器", "en": "Inspired by the Aaalice workflow's latent upscale; the tested version omitted its Tile preprocessor"},
  "packs": {"AnimaLLLiteApply_sdscripts": "ComfyUI-Anima-LLLite"},
  "requires_family": "anima",
  "lllite": "tile",
  "after": "run_workflow saves the original and a separate anima_tile image. The second pass uses denoise 0.85, so inspect face, hands, clothing and composition against the base; Tile is guidance, not a guarantee. Lower denoise if the user wants less change. ColorMatch is omitted if KJNodes is absent.",
  "extras": {"ColorMatch": "ComfyUI-KJNodes"},
  "nodes": {
    "encode": {"class_type": "VAEEncodeTiled", "inputs": {"pixels": ["$save.images", "*"], "vae": ["$decode.vae", "*"], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8}},
    "enlarge": {"class_type": "LatentUpscaleBy", "inputs": {"samples": ["encode", 0], "upscale_method": "bislerp", "scale_by": 1.22}},
    "tile": {"class_type": "AnimaLLLiteApply_sdscripts", "inputs": {"model": ["$sampler.model", "*"], "lllite_name": "$lllite", "image": ["$save.images", "*"], "strength": 0.7, "start_percent": 0.0, "end_percent": 0.8, "preserve_wrapper": true}},
    "redraw": {"class_type": "KSampler", "like": "$sampler", "inputs": {"model": ["tile", 0], "positive": ["$sampler.positive", "*"], "negative": ["$sampler.negative", "*"], "latent_image": ["enlarge", 0], "steps": 30, "cfg": 4.4, "sampler_name": "dpmpp_2m_sde_gpu", "scheduler": "sgm_uniform", "denoise": 0.85}},
    "decode": {"class_type": "VAEDecodeTiled", "inputs": {"samples": ["redraw", 0], "vae": ["$decode.vae", "*"], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8}},
    "match": {"class_type": "ColorMatch", "optional": true, "inputs": {"image_ref": ["$save.images", "*"], "image_target": ["decode", 0], "method": "mkl", "strength": 1.0, "multithread": true}},
    "save": {"class_type": "SaveImage", "inputs": {"images": ["match|decode", 0], "filename_prefix": "anima_tile"}}
  }
}
