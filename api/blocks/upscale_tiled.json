{
  "job": "upscale",
  "want": "2x",
  "rank": 4,
  "short": "2×, in tiles",
  "title": {
    "zh": "分块放大",
    "en": "Tiled upscale"
  },
  "about": {
    "zh": "放大 2 倍，按小块逐块重画，多大的图都放得下。",
    "en": "2×, redrawn tile by tile, for any size."
  },
  "source": {
    "zh": "节点包 UltimateSDUpscale 自带的示例",
    "en": "UltimateSDUpscale's own example"
  },
  "packs": {
    "UltimateSDUpscale": "ComfyUI_UltimateSDUpscale"
  },
  "instead": "upscale",
  "upscaler": true,
  "after": "run_workflow saves the picture as before and the 2× one beside it (prefix upscaled); each tile is redrawn with the sampler's steps and cfg at denoise 0.3 (higher adds more detail, and may add seams).",
  "extras": {
    "ColorMatch": "ComfyUI-KJNodes"
  },
  "notes": "ColorMatch mkl after the redraw is the source's, optional (KJNodes).",
  "upscale_by": 2.0,
  "nodes": {
    "upscaler": {
      "class_type": "UpscaleModelLoader",
      "inputs": {
        "model_name": "$upscaler"
      }
    },
    "tiles": {
      "class_type": "UltimateSDUpscale",
      "like": "$sampler",
      "inputs": {
        "image": [
          "$save.images",
          "*"
        ],
        "model": [
          "$sampler.model",
          "*"
        ],
        "positive": [
          "$sampler.positive",
          "*"
        ],
        "negative": [
          "$sampler.negative",
          "*"
        ],
        "vae": [
          "$decode.vae",
          "*"
        ],
        "upscale_model": [
          "upscaler",
          0
        ],
        "upscale_by": 2.0,
        "denoise": 0.3,
        "tile_width": 1024,
        "tile_height": 1024
      }
    },
    "match": {
      "class_type": "ColorMatch",
      "optional": true,
      "inputs": {
        "image_ref": [
          "$save.images",
          "*"
        ],
        "image_target": [
          "tiles",
          0
        ],
        "method": "mkl",
        "strength": 1.0,
        "multithread": true
      }
    },
    "save": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "match|tiles",
          0
        ],
        "filename_prefix": "upscaled"
      }
    }
  },
  "models": [
    "2x_animesharp_v4",
    "4x_ultrasharp"
  ],
  "tested": {
    "gpu": "RTX 4050 Laptop",
    "vram_gb": 6,
    "date": "2026-10-27",
    "runs": [
      {
        "model": "SDXL (Illustrious)",
        "size": "832×1216 → 2×",
        "seconds": 167
      }
    ]
  }
}
