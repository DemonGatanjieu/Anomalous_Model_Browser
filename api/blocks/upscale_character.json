            "steps": 30,
            "cfg": 4.4,
            "sampler_name": "dpmpp_2m_sde_gpu",
            "scheduler": "sgm_uniform",
            "denoise": 0.7
          }
        },
        "decode": {
          "class_type": "VAEDecodeTiled",
          "inputs": {"samples": ["redraw", 0], "vae": ["$decode.vae", "*"], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8}
        },
        "stitch": {
          "class_type": "InpaintStitchImproved",
          "inputs": {"stitcher": ["crop", "stitcher"], "inpainted_image": ["decode", 0]}
        },
        "save": {
          "class_type": "SaveImage",
          "inputs": {"images": ["stitch", 0], "filename_prefix": "upscaled_character"}
        },
        "look": {
          "class_type": "PreviewImage",
          "inputs": {"images": ["fade", 0]}
        }
      },
      "after": "On this Anima model run_workflow saves the picture as before and the 1.5x one beside it (prefix upscaled_character): the whole picture enlarged by an upscale model, the background left as it is, only the character (cut out, cropped with a margin) redrawn with its own copy of the canvas's model and LoRAs (the loader titled Upscale model) and stitched back. The Tile (node tile) holds the character's lines, so it redraws at denoise 0.7 (30 steps, dpmpp_2m_sde_gpu, the tested route); without the tile node (no animaTileRepair file here) set redraw's denoise to 0.45. Only for a background blurred on purpose: on a sharp one the character comes out sharper than the enlarged background; there use want=\"detail\". A second model for the character: set_model that loader to another Anima model; the LoRAs stay. The preview shows what is redrawn (white): part of the character missing, or the background in it, say so. The Tile LLLite fits the 2B Anima models; on a larger one (such as Harem 2.9B) the run stops with \"depth_embed slices missing\": then remove_nodes the tile node and set redraw's denoise to 0.45, or set_model a 2B Anima model there."
    }
  }
}
