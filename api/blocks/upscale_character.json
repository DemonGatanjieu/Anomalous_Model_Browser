          }
        },
        "tile": {
          "class_type": "AnimaLLLiteApply_sdscripts",
          "optional": true,
          "inputs": {
            "model": ["own", 0],
            "lllite_name": "$tile",
            "image": ["crop", "cropped_image"],
            "strength": 0.7,
            "start_percent": 0.0,
            "end_percent": 0.8,
            "preserve_wrapper": true
          }
        },
        "soft": {
          "class_type": "DifferentialDiffusion",
          "inputs": {"model": ["tile|own", 0]}
        },
        "encode": {
          "class_type": "VAEEncodeTiled",
          "inputs": {"pixels": ["crop", "cropped_image"], "vae": ["$decode.vae", "*"], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8}
        },
        "area": {
          "class_type": "SetLatentNoiseMask",
          "inputs": {"samples": ["encode", 0], "mask": ["crop", "cropped_mask"]}
        },
        "redraw": {
